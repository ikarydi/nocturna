# Copy to .env and adjust. .env is git-ignored; never commit credentials.
DATABASE_URL=sqlite:///./data/nocturna.db
# DATABASE_URL=postgresql+psycopg://nocturna:nocturna@localhost:5432/nocturna
AUDIO_DIR=./data/audio
AUTO_MIGRATE=true

# Delivery export: YouTube normalizes playback to about -14 LUFS.
DELIVERY_LUFS=-14
DELIVERY_TRUE_PEAK_DBTP=-1
MAX_UPLOAD_MB=1024

# Generation. Enable only after the adapter's /health is ok (see docs/generation.md).
ACE_STEP_ENABLED=false
# The Nocturna adapter (port 8002), NOT ACE-Step's own server (port 8001).
ACE_STEP_URL=http://127.0.0.1:8002
ACE_STEP_TIMEOUT_S=3600

# Adapter settings (used by `uvicorn nocturna.adapter.app:app --port 8002`)
ADAPTER_ACESTEP_URL=http://127.0.0.1:8001
ADAPTER_MEDIA_DIR=./data/audio
ADAPTER_MODEL=
ADAPTER_INFERENCE_STEPS=8
ADAPTER_THINKING=false
ADAPTER_ACESTEP_REPO_DIR=
ADAPTER_LICENSE=MIT
