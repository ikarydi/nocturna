# Copy to .env and adjust. .env is git-ignored; never commit credentials.
DATABASE_URL=sqlite:///./data/nocturna.db
# DATABASE_URL=postgresql+psycopg://nocturna:nocturna@localhost:5432/nocturna
AUDIO_DIR=./data/audio
AUTO_MIGRATE=true

# Delivery export: YouTube normalizes playback to about -14 LUFS.
DELIVERY_LUFS=-14
DELIVERY_TRUE_PEAK_DBTP=-1
MAX_UPLOAD_MB=1024

# Leave false on CPU-only machines. Enable only after the GPU adapter's /health is ok.
ACE_STEP_ENABLED=false
ACE_STEP_URL=http://127.0.0.1:8001
